# CivicBrain Environment Configuration Template
# Copy this file to .env and configure your values.
# DO NOT commit real credentials or secrets to version control.

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CivicBrain"
API_V1_STR="/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"

# Database (Supabase PostgreSQL with PostGIS)
# Use session pooling (port 5432) or transaction pooling (port 6543)
DATABASE_URL="postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"
DATABASE_URL_SYNC="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# Supabase Client Settings (Auth, Storage, RLS)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Restricted to background workers - NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Upstash Redis Broker / Cache (Free tier)
UPSTASH_REDIS_URL="rediss://default:your-token@your-endpoint.upstash.io:6379"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,https://civicbrain.org"
